rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{id} {
      // qualquer um pode ver o ranking
      allow read: if true;
      // só cria pontuações válidas; ninguém edita nem apaga
      allow create: if request.resource.data.keys().hasOnly(
          ['player','wpm','accuracy','time_ms','position','difficulty','car','created_at','uid'])
        && request.resource.data.player is string
        && request.resource.data.player.size() <= 16
        && request.resource.data.wpm is int
        && request.resource.data.wpm >= 0 && request.resource.data.wpm <= 300
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy <= 100
        && request.resource.data.created_at == request.time
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    // progresso de cada piloto: só o dono lê e grava
    match /progress/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['nickname','carId','color','trackId','difficulty','duration','stats','xp','streak','wheel','neon','smoke','updated_at'])
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 16
        && request.resource.data.updated_at == request.time;
      allow delete: if false;
    }
  }
}
