# Opcional: preencha com o firebaseConfig do seu app web (Console Firebase >
# Configurações do projeto > Seus apps) para ativar login e ranking online.
# Sem estas variáveis o jogo usa ranking local (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
